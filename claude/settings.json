{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 180,
  "permissions": {
    "allow": [
      "Bash(tree:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "Bash(gh discussion view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!.env.example)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "attribution": {
    "sessionUrl": false
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.py",
    "padding": 0
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "kotlin-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "productivity@rmakiyama": true,
    "development@rmakiyama": true,
    "typesafe@typesafe-ai": true
  },
  "extraKnownMarketplaces": {
    "rmakiyama": {
      "source": {
        "source": "github",
        "repo": "rmakiyama/skills"
      },
      "autoUpdate": true
    }
  },
  "language": "日本語",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "promptSuggestionEnabled": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
